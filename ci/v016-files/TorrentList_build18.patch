     private func extractArchive(_ url: URL, password: String?) {
+        // V0.1.6 Build 18 crash guard: a split 7z selected through the context
+        // menu used to immediately probe libarchive with no passphrase. Some
+        // encrypted 7z headers can fail below Swift before an Error is returned.
+        // For split volumes, nil means the user has not chosen a password mode
+        // yet, so route through the password dialog first. An explicitly empty
+        // string still means “this split archive has no password”.
+        if ArchiveExtractor.isSevenZipVolume(url), password == nil {
+            promptSevenZipVolumePassword(url)
+            return
+        }
+
         let destination = service.suggestedExtractionDirectory(for: url)
         let progress = UIAlertController(title: "正在解压", message: url.lastPathComponent, preferredStyle: .alert)
         present(progress, animated: true)
