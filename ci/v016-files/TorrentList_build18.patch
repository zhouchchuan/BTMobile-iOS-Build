+    private func promptSevenZipVolumePassword(_ url: URL) {
+        let alert = UIAlertController(
+            title: "7z 分卷解压",
+            message: "如果这是加密分卷，请输入密码；无密码分卷可直接选择“无密码解压”。",
+            preferredStyle: .alert
+        )
+        alert.addTextField { field in
+            field.placeholder = "输入解压密码"
+            field.isSecureTextEntry = true
+            field.clearButtonMode = .whileEditing
+        }
+        alert.addAction(UIAlertAction(title: "取消", style: .cancel))
+        alert.addAction(UIAlertAction(title: "无密码解压", style: .default) { [weak self] _ in
+            self?.extractArchive(url, password: "")
+        })
+        alert.addAction(UIAlertAction(title: "密码解压", style: .default) { [weak self, weak alert] _ in
+            guard let password = alert?.textFields?.first?.text, !password.isEmpty else {
+                let error = ArchiveExtractor.ExtractionError(message: "请输入 7z 分卷密码，或选择“无密码解压”")
+                self?.showError(error)
+                return
+            }
+            self?.extractArchive(url, password: password)
+        })
+        present(alert, animated: true)
+    }
