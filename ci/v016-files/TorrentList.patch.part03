+    private var encodingName = "UTF-8"
+    private var originalBOM: Data?
+    private var lastSavedText = ""
+    private var saveButton: UIBarButtonItem!
+    private var previousInteractivePopEnabled: Bool?
+
+    init(fileURL: URL) {
+        self.fileURL = fileURL
+        super.init(nibName: nil, bundle: nil)
+    }
+
+    @available(*, unavailable)
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        view.backgroundColor = .systemBackground
+        title = fileURL.lastPathComponent
+        navigationItem.largeTitleDisplayMode = .never
+
+        textView.translatesAutoresizingMaskIntoConstraints = false
+        textView.delegate = self
+        textView.isEditable = true
+        textView.isSelectable = true
+        textView.alwaysBounceVertical = true
+        textView.font = .monospacedSystemFont(ofSize: 15, weight: .regular)
+        textView.textContainerInset = UIEdgeInsets(top: 14, left: 12, bottom: 20, right: 12)
+        textView.autocorrectionType = .no
+        textView.autocapitalizationType = .none
+        textView.smartQuotesType = .no
+        textView.smartDashesType = .no
+        textView.smartInsertDeleteType = .no
+        view.addSubview(textView)
+
+        NSLayoutConstraint.activate([
+            textView.leadingAnchor.constraint(equalTo: view.safeAreaLayoutGuide.leadingAnchor),
+            textView.trailingAnchor.constraint(equalTo: view.safeAreaLayoutGuide.trailingAnchor),
+            textView.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor),
+            textView.bottomAnchor.constraint(equalTo: view.bottomAnchor)
+        ])
+
+        saveButton = UIBarButtonItem(title: "保存", style: .done, target: self, action: #selector(saveText))
+        saveButton.isEnabled = false
+        navigationItem.rightBarButtonItems = [saveButton, makeTextActionsButton()]
+        navigationItem.leftBarButtonItem = UIBarButtonItem(
+            title: "返回",
+            style: .plain,
+            target: self,
+            action: #selector(requestClose)
+        )
+
+        installKeyboardToolbar()
+        loadText()
+    }
+
+    override func viewWillAppear(_ animated: Bool) {
+        super.viewWillAppear(animated)
+        if previousInteractivePopEnabled == nil {
+            previousInteractivePopEnabled = navigationController?.interactivePopGestureRecognizer?.isEnabled
+        }
+        // A custom back confirmation protects unsaved edits.  Restore the
+        // navigation controller's previous gesture state when leaving.
+        navigationController?.interactivePopGestureRecognizer?.isEnabled = false
+    }
+
+    override func viewWillDisappear(_ animated: Bool) {
+        super.viewWillDisappear(animated)
+        if let previousInteractivePopEnabled {
+            navigationController?.interactivePopGestureRecognizer?.isEnabled = previousInteractivePopEnabled
+        }
+    }
+
+    func textViewDidChange(_ textView: UITextView) { updateDirtyState() }
+
+    private var hasUnsavedChanges: Bool { textView.text != lastSavedText }
+
+    private func updateDirtyState() {
+        let dirty = hasUnsavedChanges
+        saveButton?.isEnabled = dirty
+        title = dirty ? "\(fileURL.lastPathComponent) •" : fileURL.lastPathComponent
+    }
+
+    private func loadText() {
+        do {
+            let data = try Data(contentsOf: fileURL, options: [.mappedIfSafe])
+            guard let decoded = Self.decode(data) else {
+                throw TextEditorError.unsupportedEncoding
+            }
+            fileEncoding = decoded.encoding
+            encodingName = decoded.encodingName
+            originalBOM = decoded.bom
+            textView.text = decoded.text
+            lastSavedText = decoded.text
+            updateDirtyState()
+            navigationItem.prompt = "文本编辑 · \(encodingName)"
+        } catch {
+            textView.isEditable = false
+            textView.text = ""
+            showError(error)
+        }
+    }
+
+    private func makeTextActionsButton() -> UIBarButtonItem {
+        let selectAll = UIAction(title: "全选", image: UIImage(systemName: "selection.pin.in.out")) { [weak self] _ in
+            guard let self else { return }
+            textView.becomeFirstResponder()
+            textView.selectedRange = NSRange(location: 0, length: (textView.text as NSString).length)
+        }
+        let copySelection = UIAction(title: "复制选中", image: UIImage(systemName: "doc.on.doc")) { [weak self] _ in
+            self?.copySelectedText()
+        }
+        let share = UIAction(title: "用其他 App 打开", image: UIImage(systemName: "square.and.arrow.up")) { [weak self] _ in
+            self?.shareTextFile()
+        }
+        return UIBarButtonItem(
+            title: "更多",
+            image: UIImage(systemName: "ellipsis.circle"),
+            primaryAction: nil,
+            menu: UIMenu(children: [copySelection, selectAll, share])
+        )
+    }
+
+    private func installKeyboardToolbar() {
+        let toolbar = UIToolbar()
+        toolbar.sizeToFit()
+        toolbar.items = [
+            UIBarButtonItem(title: "全选", style: .plain, target: self, action: #selector(selectAllText)),
+            UIBarButtonItem(title: "复制选中", style: .plain, target: self, action: #selector(copySelectedText)),
+            UIBarButtonItem(barButtonSystemItem: .flexibleSpace, target: nil, action: nil),
+            UIBarButtonItem(title: "完成", style: .done, target: self, action: #selector(dismissKeyboard))
+        ]
+        textView.inputAccessoryView = toolbar
+    }
+
+    @objc private func selectAllText() {
+        textView.selectedRange = NSRange(location: 0, length: (textView.text as NSString).length)
+    }
+
+    @objc private func copySelectedText() {
+        let selected = textView.selectedRange
+        guard selected.length > 0,
+              selected.location != NSNotFound,
+              NSMaxRange(selected) <= (textView.text as NSString).length else {
+            showMessage(title: "没有选中文本", message: "请先长按并拖动选择需要复制的段落。")
+            return
+        }
+        UIPasteboard.general.string = (textView.text as NSString).substring(with: selected)
+        showMessage(title: "已复制", message: "选中的文字已经复制到剪贴板。")
+    }
+
+    @objc private func dismissKeyboard() { textView.resignFirstResponder() }
+
+    @objc private func saveText() {
+        do {
+            try writeCurrentText()
+            lastSavedText = textView.text
+            updateDirtyState()
+            navigationItem.prompt = "已保存 · \(encodingName)"
+        } catch {
+            showError(error)
+        }
+    }
+
+    private func writeCurrentText() throws {
+        guard var data = textView.text.data(using: fileEncoding, allowLossyConversion: false) else {
+            throw TextEditorError.cannotEncode(encodingName)
+        }
+        if let bom = originalBOM, !data.starts(with: bom) {
+            data = bom + data
+        }
+        try data.write(to: fileURL, options: .atomic)
+    }
+
+    @objc private func requestClose() {
+        guard hasUnsavedChanges else {
+            navigationController?.popViewController(animated: true)
+            return
+        }
+        let alert = UIAlertController(title: "保存修改？", message: fileURL.lastPathComponent, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "取消", style: .cancel))
+        alert.addAction(UIAlertAction(title: "不保存", style: .destructive) { [weak self] _ in
+            self?.navigationController?.popViewController(animated: true)
+        })
+        alert.addAction(UIAlertAction(title: "保存并返回", style: .default) { [weak self] _ in
+            guard let self else { return }
+            do {
+                try writeCurrentText()
+                lastSavedText = textView.text
+                navigationController?.popViewController(animated: true)
+            } catch {
+                showError(error)
+            }
+        })
+        present(alert, animated: true)
+    }
+
+    private func shareTextFile() {
+        let controller = UIActivityViewController(activityItems: [fileURL], applicationActivities: nil)
