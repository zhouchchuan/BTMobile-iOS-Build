+    private func presentFileInfo(_ item: BTFileManagerService.Item) {
+        let type: String
+        if item.isDirectory {
+            type = "文件夹"
+        } else if item.pathExtension.isEmpty {
+            type = "文件"
+        } else {
+            type = item.pathExtension.uppercased()
+        }
+        let size = item.isDirectory ? "—" : ByteCountFormatter.string(fromByteCount: max(item.size, 0), countStyle: .file)
+        let modified: String
+        if let date = item.modificationDate {
+            let formatter = DateFormatter()
+            formatter.locale = Locale(identifier: "zh_CN")
+            formatter.dateFormat = "yyyy-MM-dd HH:mm:ss"
+            modified = formatter.string(from: date)
+        } else {
+            modified = "未知"
+        }
+        let message = "类型：\(type)\n大小：\(size)\n修改时间：\(modified)\n位置：\(relativePath(item.url.deletingLastPathComponent()))"
+        let alert = UIAlertController(title: item.name, message: message, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "好", style: .default))
+        present(alert, animated: true)
+    }
+
     private func iconName(for item: BTFileManagerService.Item) -> String {
         if item.isDirectory { return "folder.fill" }
         if item.isArchive { return "archivebox.fill" }
         if item.isVideo { return "play.rectangle.fill" }
         switch item.pathExtension {
-        case "jpg", "jpeg", "png", "gif", "webp", "heic": return "photo.fill"
+        case "jpg", "jpeg", "png", "gif", "webp", "heic", "heif", "bmp", "tif", "tiff": return "photo.fill"
+        case "txt": return "doc.text.fill"
         case "mp3", "m4a", "aac", "flac", "wav", "ogg": return "music.note"
         case "pdf": return "doc.richtext.fill"
         default: return "doc.fill"
         }
     }
 
+    // MARK: V0.1.6 built-in viewers
+    private func openImage(_ url: URL) {
+        let controller = BTImageViewerViewController(fileURL: url)
+        navigationController?.pushViewController(controller, animated: true)
+    }
+
+    private func openTextEditor(_ url: URL) {
+        let controller = BTTextEditorViewController(fileURL: url)
+        navigationController?.pushViewController(controller, animated: true)
+    }
+
     // MARK: File operations
