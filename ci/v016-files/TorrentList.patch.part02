+// MARK: - BTMobile V0.1.6 TXT Viewer / Editor
+
+/// Plain-text viewer/editor used only for .txt files.  UITextView keeps the
+/// native iOS selection handles and Copy menu, while explicit Select All and
+/// Copy Selection actions make paragraph copying easy without leaving BTMobile.
+final class BTTextEditorViewController: UIViewController, UITextViewDelegate {
+    private struct DecodedText {
+        let text: String
+        let encoding: String.Encoding
+        let encodingName: String
+        let bom: Data?
+    }
+
+    private let fileURL: URL
+    private let textView = UITextView()
+    private var fileEncoding: String.Encoding = .utf8
